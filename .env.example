# Synthetic local development only. npm run db:local creates ignored local credentials.
DATABASE_URL=postgresql://gym_runtime:REPLACE@127.0.0.1:55432/gym_crm_synthetic
# Keep MIGRATION_DATABASE_URL only in .env.migration.local, never Next.js runtime env files.
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
BETTER_AUTH_URL=http://127.0.0.1:3000
SYNTHETIC_DATA_ONLY=true
