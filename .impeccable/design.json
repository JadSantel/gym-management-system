  "narrative": {
    "northStar": "The calm operations workspace",
    "overview": "Neutral surfaces, restrained emerald actions, and clear account states support reception work and careful review. The system uses ordinary system typography, fine separators, and stable navigation; hierarchy comes from placement and spacing rather than decoration. This describes the implemented user-selected direction, not a new gym brand.\n\nThis file records visual implementation. `docs/PROJECT.md` and `docs/architecture.md` remain authoritative for behavior and permissions. The roster-first Team & access composition is documented in `.impeccable/surfaces/src-app-page-tsx.md`; other screens need not repeat that composition. No shipping raster assets are used.",
    "keyCharacteristics": [
      "First-class light and dark surfaces.",
      "Restrained emerald actions and explicit textual statuses.",
      "Flat panels, fine borders, and consistent spacing.",
      "Responsive, permission-appropriate navigation."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Use semantic foreground/background pairs; do not carry a light-mode literal into a dark-mode component.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** use semantic theme tokens and preserve foreground/background pairs.",
      "**Do** keep status text, associated field errors, visible focus, and 44px principal targets.",
      "**Do** reuse the actively imported local primitives and native controls where suitable.",
      "**Do** inspect light and dark rendering at phone, tablet, and desktop widths."
    ],
    "donts": [
      "**Don't** introduce charcoal panels into light mode or separate page-specific palettes.",
      "**Don't** use color alone to imply account state, payment completion, or authority.",
      "**Don't** add decorative metrics, stock imagery, or nested cards to fill space.",
      "**Don't** treat this visual record as pilot, accessibility-certification, or live-readiness evidence."
    ]
  }
