generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  username      String?   @unique
  displayUsername String?
  sessions      Session[]
  accounts      Account[]
  operator      Operator?
  @@map("auth_users")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  reauthenticatedAt DateTime? @db.Timestamptz(3)
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  @@index([identifier])
  @@map("auth_verifications")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
  @@map("auth_rate_limits")
}

enum OperatorRole {
  OWNER
  STAFF
}

enum AccessState {
  PENDING
  ACTIVE
  DISABLED
}

enum InvitePurpose {
  OWNER_SETUP
  STAFF_SETUP
  OWNER_RESET
  STAFF_RESET
}

model Gym {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  state     AccessState @default(PENDING)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  operators Operator[]
  invitations Invitation[]
  auditEvents IdentityAudit[]
  members Member[]
  plans Plan[]
  charges Charge[]
  payments Payment[]
  membershipPeriods MembershipPeriod[]
  entitlements EffectiveEntitlement[]
  idempotencyOperations IdempotencyOperation[]
  receipts PaymentReceipt[]
  @@map("gyms")
}

// Global identity binding, separate from tenant business records. S-01b must narrow runtime access.
model Operator {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @unique
  gymId     String @map("gym_id") @db.Uuid
  role      OperatorRole
  state     AccessState @default(PENDING)
  canManageMembers Boolean @default(false)
  canCollectCash Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id])
  gym       Gym @relation(fields: [gymId], references: [id])
  invitations Invitation[]
  @@unique([id, gymId])
  createdMembers Member[]
  createdPlans Plan[]
  preparedCharges Charge[]
  @@index([gymId])
  @@map("gym_operators")
  collectedPayments Payment[] @relation("CashCollector")
  confirmedPayments Payment[] @relation("CashVerifier")
  confirmedPeriods MembershipPeriod[]
}

model Invitation {
  id         String @id @default(uuid()) @db.Uuid
  gymId      String @map("gym_id") @db.Uuid
  operatorId String @db.Uuid
  purpose    InvitePurpose
  tokenHash  String @unique
  expiresAt  DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  sentAt     DateTime? @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  operator   Operator @relation(fields: [operatorId, gymId], references: [id, gymId])
  gym        Gym @relation(fields: [gymId], references: [id])
  @@index([operatorId])
  @@map("identity_invitations")
}

model IdentityAudit {
  id          String @id @default(uuid()) @db.Uuid
  gymId       String @map("gym_id") @db.Uuid
  initiatorId String
  subjectId   String
  action      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  gym         Gym @relation(fields: [gymId], references: [id])
  @@index([gymId, createdAt])
  @@map("identity_audit")
}

model Member {
  id        String @id @default(uuid()) @db.Uuid
  gymId     String @map("gym_id") @db.Uuid
  fullName  String @map("full_name")
  nameKey   String @map("name_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String @map("created_by") @db.Uuid
  gym       Gym @relation(fields: [gymId], references: [id])
  creator   Operator @relation(fields: [createdBy, gymId], references: [id, gymId])
  charges   Charge[]
  payments Payment[]
  membershipPeriods MembershipPeriod[]
  entitlements EffectiveEntitlement[]
  @@unique([id, gymId])
  @@index([gymId, nameKey])
  @@map("members")
}

model Plan {
  id            String @id @default(uuid()) @db.Uuid
  gymId         String @map("gym_id") @db.Uuid
  name          String
  durationDays  Int @map("duration_days")
  priceCentavos Int @map("price_centavos")
  version       Int @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String @map("created_by") @db.Uuid
  gym           Gym @relation(fields: [gymId], references: [id])
  creator       Operator @relation(fields: [createdBy, gymId], references: [id, gymId])
  charges       Charge[]
  @@unique([id, gymId], map: "plans_id_gym_key")
  @@unique([gymId, durationDays], map: "plans_gym_duration_key")
  @@map("plans")
}

model Charge {
  id            String @id @default(uuid()) @db.Uuid
  gymId         String @map("gym_id") @db.Uuid
  memberId      String @map("member_id") @db.Uuid
  planId        String @map("plan_id") @db.Uuid
  planName      String @map("plan_name")
  durationDays  Int @map("duration_days")
  priceCentavos Int @map("price_centavos")
  planVersion   Int @map("plan_version")
  preparedBy    String @map("prepared_by") @db.Uuid
  preparedAt    DateTime @default(now()) @map("prepared_at") @db.Timestamptz(3)
  intendedStart DateTime @map("intended_start") @db.Timestamptz(3)
  intendedEnd   DateTime @map("intended_end") @db.Timestamptz(3)
  gym           Gym @relation(fields: [gymId], references: [id])
  member        Member @relation(fields: [memberId, gymId], references: [id, gymId])
  plan          Plan @relation(fields: [planId, gymId], references: [id, gymId])
  preparer      Operator @relation(fields: [preparedBy, gymId], references: [id, gymId])
  @@unique([id, gymId], map: "charges_id_gym_key")
  @@index([gymId, memberId], map: "charges_gym_member_idx")
  @@map("charge_snapshots")
  payment Payment?
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  chargeId String @unique @map("charge_id") @db.Uuid
  reference String @unique
  amountCentavos Int @map("amount_centavos")
  currencyCode String @default("PHP") @map("currency_code")
  method String @default("CASH")
  collectedBy String @map("collected_by") @db.Uuid
  collectedAt DateTime @map("collected_at") @db.Timestamptz(3)
  enteredAt DateTime @default(now()) @map("entered_at") @db.Timestamptz(3)
  verifiedBy String @map("verified_by") @db.Uuid
  verifiedAt DateTime @default(now()) @map("verified_at") @db.Timestamptz(3)
  gym Gym @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId, gymId], references: [id, gymId])
  charge Charge @relation(fields: [chargeId, gymId], references: [id, gymId])
  collector Operator @relation("CashCollector", fields: [collectedBy, gymId], references: [id, gymId])
  verifier Operator @relation("CashVerifier", fields: [verifiedBy, gymId], references: [id, gymId])
  period MembershipPeriod?
  receipt PaymentReceipt?
  idempotencyOperations IdempotencyOperation[]
  @@unique([chargeId, gymId])
  @@unique([id, gymId])
  @@map("payments")
}

model MembershipPeriod {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  paymentId String @unique @map("payment_id") @db.Uuid
  confirmedBy String @map("confirmed_by") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  gym Gym @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId, gymId], references: [id, gymId])
  payment Payment @relation(fields: [paymentId, gymId], references: [id, gymId])
  confirmer Operator @relation(fields: [confirmedBy, gymId], references: [id, gymId])
  entitlement EffectiveEntitlement?
  @@unique([paymentId, gymId])
  @@unique([id, gymId])
  @@map("membership_periods")
}

model EffectiveEntitlement {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  periodId String @unique @map("period_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  isCurrentProjection Boolean @default(true) @map("is_current_projection")
  gym Gym @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId, gymId], references: [id, gymId])
  period MembershipPeriod @relation(fields: [periodId, gymId], references: [id, gymId])
  @@unique([periodId, gymId])
  @@unique([id, gymId])
  @@map("effective_entitlement_intervals")
}

model IdempotencyOperation {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  operationType String @map("operation_type")
  operationKey String @map("operation_key")
  requestFingerprint String @map("request_fingerprint")
  paymentId String? @map("payment_id") @db.Uuid
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  gym Gym @relation(fields: [gymId], references: [id])
  payment Payment? @relation(fields: [paymentId, gymId], references: [id, gymId])
  @@unique([gymId, operationType, operationKey])
  @@map("idempotency_operations")
}

model PaymentReceipt {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  paymentId String @unique @map("payment_id") @db.Uuid
  reference String @unique
  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  gym Gym @relation(fields: [gymId], references: [id])
  payment Payment @relation(fields: [paymentId, gymId], references: [id, gymId])
  @@unique([paymentId, gymId])
  @@map("payment_receipts")
}

model ReceivingAccount {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  label String
  method String
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([id, gymId])
  @@unique([gymId, label])
  @@map("receiving_accounts")
}

model DigitalVerifier {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  active Boolean @default(true)
  @@unique([accountId, operatorId])
  @@map("digital_verifiers")
}

model DigitalClaim {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  chargeId String @unique @map("charge_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  amountCentavos Int @map("amount_centavos")
  transactionReference String @map("transaction_reference")
  reportedReceivedAt DateTime @map("reported_received_at") @db.Timestamptz(3)
  collectedBy String @map("collected_by") @db.Uuid
  enteredAt DateTime @default(now()) @map("entered_at") @db.Timestamptz(3)
  @@unique([id, gymId])
  @@unique([accountId, transactionReference])
  @@map("digital_claims")
}

model DigitalSettlement {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  claimId String @unique @map("claim_id") @db.Uuid
  paymentId String @unique @map("payment_id") @db.Uuid
  evidenceReference String @map("evidence_reference")
  accountMatched Boolean @default(true) @map("account_matched")
  @@map("digital_settlements")
}

model PaymentFlag {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  reason String
  reportedBy String @map("reported_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([paymentId, reason])
  @@map("payment_flags")
}

model InvestigationCase {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  reason String
  summary String
  method String
  claimedCentavos Int? @map("claimed_centavos")
  originalCollectedAt DateTime? @map("original_collected_at") @db.Timestamptz(3)
  openedBy String @map("opened_by") @db.Uuid
  openedAt DateTime @default(now()) @map("opened_at") @db.Timestamptz(3)
  @@unique([id, gymId])
  @@index([gymId, openedAt])
  @@map("investigation_cases")
}

model InvestigationEvent {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  caseId String @map("case_id") @db.Uuid
  revision Int
  operationKey String @map("operation_key") @db.Uuid
  fingerprint String
  kind String
  outcome String
  reasoning String
  evidenceReference String? @map("evidence_reference")
  actorId String @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  paymentId String? @map("payment_id") @db.Uuid
  relatedPaymentId String? @map("related_payment_id") @db.Uuid
  reason String?
  collectionCount String? @map("collection_count")
  amountCentavos Int? @map("amount_centavos")
  method String?
  moneyOutcome String? @map("money_outcome")
  accessOutcome String? @map("access_outcome")
  effectiveAt DateTime? @map("effective_at") @db.Timestamptz(3)
  periodId String? @map("period_id") @db.Uuid
  retainedPeriodId String? @map("retained_period_id") @db.Uuid
  requestEventId String? @map("request_event_id") @db.Uuid
  decision String?
  @@unique([id, gymId])
  @@unique([gymId, operationKey])
  @@unique([caseId, revision])
  @@map("investigation_events")
}
