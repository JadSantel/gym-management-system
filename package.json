{
  "name": "gym-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "bootstrap:synthetic": "tsx --conditions=react-server --env-file=.env.local --env-file=.env.migration.local scripts/bootstrap-synthetic.ts",
    "test:browser": "tsx --conditions=react-server --env-file=.env.local --env-file=.env.migration.local scripts/test-identity-browser.ts",
    "test": "tsx --conditions=react-server --env-file=.env.local --env-file=.env.migration.local --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.12",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
